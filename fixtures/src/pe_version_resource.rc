// Self-authored resource script for a never-executed static fixture.
// Version strings are untrusted declarations, not proof of product identity.
#include <winver.h>
1 VERSIONINFO
FILEVERSION 0,9,0,1
PRODUCTVERSION 0,9,0,0
FILEFLAGSMASK 0x3f
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Bytasm fixture authors"
      VALUE "FileDescription", "Bytasm static fixture, never executed"
      VALUE "FileVersion", "0.9.0.1"
      VALUE "ProductName", "Bytasm fixture"
      VALUE "ProductVersion", "0.9.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
2 RCDATA
BEGIN
  "bytasm fixture resource payload"
END
