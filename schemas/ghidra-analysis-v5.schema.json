{
  "$defs": {
    "Address": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Address",
          "type": "string"
        },
        "space": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Space",
          "type": "string"
        }
      },
      "required": [
        "space",
        "address"
      ],
      "title": "Address",
      "type": "object"
    },
    "BasicBlock": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "$ref": "#/$defs/Address"
        },
        "flows": {
          "items": {
            "$ref": "#/$defs/BlockFlow"
          },
          "maxItems": 8,
          "title": "Flows",
          "type": "array"
        },
        "flows_truncated": {
          "title": "Flows Truncated",
          "type": "boolean"
        },
        "instruction_count": {
          "maximum": 4096,
          "minimum": 0,
          "title": "Instruction Count",
          "type": "integer"
        },
        "start": {
          "$ref": "#/$defs/Address"
        },
        "terminal": {
          "title": "Terminal",
          "type": "boolean"
        }
      },
      "required": [
        "start",
        "end",
        "instruction_count",
        "terminal",
        "flows",
        "flows_truncated"
      ],
      "title": "BasicBlock",
      "type": "object"
    },
    "BlockFlow": {
      "additionalProperties": false,
      "description": "A static control-flow edge Ghidra's BasicBlockModel reports from a block.",
      "properties": {
        "internal": {
          "title": "Internal",
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "fallthrough",
            "conditional_jump",
            "unconditional_jump",
            "computed_jump"
          ],
          "title": "Kind",
          "type": "string"
        },
        "provenance": {
          "const": "ghidra_basic_block_model",
          "default": "ghidra_basic_block_model",
          "title": "Provenance",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Address"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "target",
        "kind",
        "internal"
      ],
      "title": "BlockFlow",
      "type": "object"
    },
    "BodyRange": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "$ref": "#/$defs/Address"
        },
        "provenance": {
          "const": "ghidra_function_body",
          "default": "ghidra_function_body",
          "title": "Provenance",
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/Address"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "BodyRange",
      "type": "object"
    },
    "Call": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/Address"
        },
        "target": {
          "$ref": "#/$defs/Address"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "Call",
      "type": "object"
    },
    "CallSite": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "direct",
            "indirect"
          ],
          "title": "Kind",
          "type": "string"
        },
        "provenance": {
          "const": "ghidra_instruction_flow",
          "default": "ghidra_instruction_flow",
          "title": "Provenance",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Address"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Address"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_basis": {
          "anyOf": [
            {
              "const": "ghidra_call_reference",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Basis"
        }
      },
      "required": [
        "source",
        "kind",
        "target",
        "target_basis"
      ],
      "title": "CallSite",
      "type": "object"
    },
    "FileRange": {
      "additionalProperties": false,
      "description": "Ghidra-reported mapping of an inclusive address range onto input file bytes.",
      "properties": {
        "end": {
          "$ref": "#/$defs/Address"
        },
        "file_offset": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "File Offset",
          "type": "integer"
        },
        "provenance": {
          "const": "ghidra_memory_block_file_bytes",
          "default": "ghidra_memory_block_file_bytes",
          "title": "Provenance",
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/Address"
        }
      },
      "required": [
        "start",
        "end",
        "file_offset"
      ],
      "title": "FileRange",
      "type": "object"
    },
