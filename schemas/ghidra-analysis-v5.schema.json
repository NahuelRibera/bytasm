    "Instruction": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "$ref": "#/$defs/Address"
        },
        "bytes_hex": {
          "maxLength": 64,
          "pattern": "^(?:[0-9a-f]{2})*$",
          "title": "Bytes Hex",
          "type": "string"
        },
        "bytes_truncated": {
          "default": false,
          "title": "Bytes Truncated",
          "type": "boolean"
        },
        "text": {
          "maxLength": 256,
          "title": "Text",
          "type": "string"
        },
        "text_truncated": {
          "default": false,
          "title": "Text Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "address",
        "bytes_hex",
        "text"
      ],
      "title": "Instruction",
      "type": "object"
    },
    "MemoryBlock": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "$ref": "#/$defs/Address"
        },
        "execute": {
          "title": "Execute",
          "type": "boolean"
        },
        "file_ranges": {
          "items": {
            "$ref": "#/$defs/FileRange"
          },
          "maxItems": 16,
          "title": "File Ranges",
          "type": "array"
        },
        "file_ranges_truncated": {
          "title": "File Ranges Truncated",
          "type": "boolean"
        },
        "initialized": {
          "title": "Initialized",
          "type": "boolean"
        },
        "name": {
          "maxLength": 256,
          "title": "Name",
          "type": "string"
        },
        "name_truncated": {
          "default": false,
          "title": "Name Truncated",
          "type": "boolean"
        },
        "read": {
          "title": "Read",
          "type": "boolean"
        },
        "start": {
          "$ref": "#/$defs/Address"
        },
        "write": {
          "title": "Write",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "start",
        "end",
        "read",
        "write",
        "execute",
        "initialized",
        "file_ranges",
        "file_ranges_truncated"
      ],
      "title": "MemoryBlock",
      "type": "object"
    },
    "PointerSlot": {
      "additionalProperties": false,
      "description": "Initialized memory that Ghidra reports as a data reference to a function entry.",
      "properties": {
        "address": {
          "$ref": "#/$defs/Address"
        },
        "provenance": {
          "const": "ghidra_reference_to_entry",
          "default": "ghidra_reference_to_entry",
          "title": "Provenance",
          "type": "string"
        },
        "reference_type": {
          "maxLength": 256,
          "title": "Reference Type",
          "type": "string"
        }
      },
      "required": [
        "address",
        "reference_type"
      ],
      "title": "PointerSlot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "ghidra-1"
          }
        }
      },
      "then": {
        "properties": {
          "functions": {
            "maxItems": 256
          }
        }
      }
    }
  ],
  "properties": {
    "analysis_timed_out": {
      "title": "Analysis Timed Out",
      "type": "boolean"
    },
    "compiler": {
      "maxLength": 256,
      "title": "Compiler",
      "type": "string"
    },
    "function_count": {
      "minimum": 0,
      "title": "Function Count",
      "type": "integer"
    },
    "functions": {
      "items": {
        "$ref": "#/$defs/Function"
      },
      "maxItems": 1024,
      "title": "Functions",
      "type": "array"
    },
    "functions_truncated": {
      "title": "Functions Truncated",
      "type": "boolean"
    },
    "ghidra_version": {
      "const": "12.2",
      "title": "Ghidra Version",
      "type": "string"
    },
    "image_base": {
      "anyOf": [
        {
          "$ref": "#/$defs/Address"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "language_id": {
      "maxLength": 256,
      "title": "Language Id",
      "type": "string"
    },
    "limitations": {
      "items": {
        "maxLength": 256,
        "type": "string"
      },
      "maxItems": 32,
      "title": "Limitations",
      "type": "array"
    },
    "memory_blocks": {
      "items": {
        "$ref": "#/$defs/MemoryBlock"
      },
      "maxItems": 64,
      "title": "Memory Blocks",
      "type": "array"
    },
    "memory_blocks_truncated": {
      "default": false,
      "title": "Memory Blocks Truncated",
      "type": "boolean"
    },
    "profile_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Profile Sha256",
      "type": "string"
    },
    "provider_host": {
      "default": "unavailable",
      "maxLength": 256,
      "title": "Provider Host",
      "type": "string"
    },
    "schema_version": {
      "enum": [
        "ghidra-1",
        "ghidra-2",
        "ghidra-3",
        "ghidra-4",
        "ghidra-5"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "script_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Script Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "input_sha256",
    "ghidra_version",
    "language_id",
    "compiler",
    "profile_sha256",
    "script_sha256",
    "functions",
    "function_count",
    "functions_truncated",
    "analysis_timed_out",
    "limitations"
  ],
  "title": "GhidraResult",
  "type": "object"
}
