        "call_sites": {
          "items": {
            "$ref": "#/$defs/CallSite"
          },
          "maxItems": 128,
          "title": "Call Sites",
          "type": "array"
        },
        "call_sites_truncated": {
          "default": false,
          "title": "Call Sites Truncated",
          "type": "boolean"
