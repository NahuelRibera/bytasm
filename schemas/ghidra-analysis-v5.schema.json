        "body_ranges_truncated": {
          "default": false,
          "title": "Body Ranges Truncated",
          "type": "boolean"
        },
        "body_size": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Body Size"
