        "pseudocode_status": {
          "enum": [
            "available",
            "not_selected",
            "failed"
          ],
          "title": "Pseudocode Status",
          "type": "string"
        },
        "pseudocode_truncated": {
          "title": "Pseudocode Truncated",
          "type": "boolean"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/FunctionReference"
          },
          "maxItems": 64,
          "title": "References",
          "type": "array"
        },
        "references_truncated": {
          "default": false,
          "title": "References Truncated",
          "type": "boolean"
        },
        "thunk_target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Address"
            },
            {
              "type": "null"
