          "items": {
            "$ref": "#/$defs/Call"
          },
          "maxItems": 64,
          "title": "Calls",
          "type": "array"
        },
        "calls_truncated": {
          "title": "Calls Truncated",
          "type": "boolean"
        },
        "entry": {
          "$ref": "#/$defs/Address"
        },
        "external": {
          "default": false,
          "title": "External",
          "type": "boolean"
        },
        "instruction_count": {
          "anyOf": [
            {
              "maximum": 65536,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instruction Count"
        },
        "instruction_count_capped": {
          "default": false,
          "title": "Instruction Count Capped",
          "type": "boolean"
        },
        "instructions": {
          "items": {
            "$ref": "#/$defs/Instruction"
          },
          "maxItems": 64,
          "title": "Instructions",
          "type": "array"
        },
        "instructions_truncated": {
          "title": "Instructions Truncated",
          "type": "boolean"
        },
        "name": {
          "maxLength": 256,
          "title": "Name",
          "type": "string"
        },
        "name_truncated": {
          "default": false,
          "title": "Name Truncated",
          "type": "boolean"
        },
        "namespace": {
          "maxLength": 256,
          "title": "Namespace",
          "type": "string"
        },
        "namespace_truncated": {
          "default": false,
          "title": "Namespace Truncated",
          "type": "boolean"
        },
        "pointer_slots": {
          "items": {
            "$ref": "#/$defs/PointerSlot"
