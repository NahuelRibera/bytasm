    "FunctionReference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "string",
            "data",
            "external_symbol"
          ],
          "title": "Kind",
          "type": "string"
        },
        "preview": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preview"
        },
        "preview_truncated": {
          "default": false,
          "title": "Preview Truncated",
          "type": "boolean"
        },
        "provenance": {
          "const": "ghidra_instruction_reference",
          "title": "Provenance",
          "type": "string"
