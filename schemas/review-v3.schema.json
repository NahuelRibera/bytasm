    "AddressMapping": {
      "additionalProperties": false,
      "description": "How addresses were related to file offsets when the graph was built.",
      "properties": {
        "declared_basis": {
          "const": "lief_section_declaration",
          "default": "lief_section_declaration",
          "title": "Declared Basis",
          "type": "string"
        },
        "declared_image_base": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Declared Image Base"
        },
        "ghidra_basis": {
          "const": "ghidra_memory_block_file_bytes",
          "default": "ghidra_memory_block_file_bytes",
          "title": "Ghidra Basis",
          "type": "string"
        },
        "ghidra_image_base": {
          "anyOf": [
            {
              "$ref": "#/$defs/SnapshotAddress"
            },
            {
              "type": "null"
            }
          ]
        },
        "ghidra_map_truncated": {
          "title": "Ghidra Map Truncated",
          "type": "boolean"
        },
        "ghidra_memory_map": {
          "enum": [
            "available",
            "unavailable",
            "not_selected"
          ],
          "title": "Ghidra Memory Map",
          "type": "string"
        },
        "ghidra_memory_map_reason": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ghidra Memory Map Reason"
        },
        "ghidra_protocol": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ghidra Protocol"
        },
        "ghidra_rejected_file_ranges": {
          "minimum": 0,
          "title": "Ghidra Rejected File Ranges",
          "type": "integer"
        }
      },
      "required": [
        "declared_image_base",
        "ghidra_protocol",
        "ghidra_memory_map",
        "ghidra_memory_map_reason",
        "ghidra_image_base",
        "ghidra_rejected_file_ranges",
        "ghidra_map_truncated"
      ],
