        "algorithm",
        "sample",
        "scope_sha256",
        "content_sha256",
        "sources",
        "address_mapping",
        "coverage",
        "nodes",
        "edges",
        "bounds",
        "limitations"
      ],
      "title": "EvidenceSnapshot",
      "type": "object"
