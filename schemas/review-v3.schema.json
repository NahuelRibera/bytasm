          "maxItems": 32,
          "title": "Limitations",
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/SnapshotNode"
          },
          "maxItems": 4096,
          "title": "Nodes",
          "type": "array"
        },
        "sample": {
          "$ref": "#/$defs/SnapshotSample"
        },
        "schema_version": {
          "const": "bytasm-evidence-snapshot-1",
          "default": "bytasm-evidence-snapshot-1",
          "title": "Schema Version",
          "type": "string"
        },
        "scope_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Scope Sha256",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SnapshotSource"
          },
          "maxItems": 5,
          "title": "Sources",
          "type": "array"
        }
